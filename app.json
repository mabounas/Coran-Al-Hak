{
  "expo": {
    "name": "Quran Al Ummah",
    "slug": "coran-al-ummah",
    "owner": "coran-al-ummah",
    "scheme": "coranalummah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#0F6E52",
    "backgroundColor": "#0F6E52",
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {}
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Coran Al Ummah to use your location to find the Qibla direction."
        }
      ],
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Coran Al Ummah to use the microphone to search the Quran by voice.",
          "speechRecognitionPermission": "Allow Coran Al Ummah to use speech recognition to search the Quran by voice."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mabounas.coranalhak",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Allow Coran Al Ummah to use speech recognition to search the Quran by voice.",
        "NSMicrophoneUsageDescription": "Allow Coran Al Ummah to use the microphone to search the Quran by voice."
      }
    },
    "android": {
      "package": "com.mabounas.coranalhak",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F6E52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d7a7e91-8c94-492c-919c-789efcb1934c"
      }
    }
  }
}
